PORT=3001
NODE_ENV=development

# MySQL Database (Local o Cloud como Railway/Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maavyt_db
DB_SSL=false

# Seguridad y Autenticación JWT (Fase 2)
JWT_SECRET=cambiar_por_clave_secreta_segura_de_produccion_aleatoria
JWT_EXPIRES_IN=8h

# CORS (Dominio del frontend en producción)
FRONTEND_URL=http://localhost:5173

# Gmail IMAP Integration (Etiqueta MAAVYT)
GMAIL_USER=tuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_LABEL=MAAVYT
GMAIL_AUTO_SYNC=false
GMAIL_SYNC_INTERVAL_MINUTES=10

# Google Gemini Vision API (Para extraer tablas de imagenes)
GEMINI_API_KEY=
